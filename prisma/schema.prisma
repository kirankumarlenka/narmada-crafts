generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
url = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
}

model DeityIdol {
  id          String      @id @default(cuid())
  name        String
  templeName  String?
  location    String?
  description String?
  images      IdolImage[]
  createdAt   DateTime    @default(now())
}

model IdolImage {
  id        String    @id @default(cuid())
  url       String
  caption   String?
  occasion  String?
  isPrimary Boolean   @default(false)
  idolId    String
  idol      DeityIdol @relation(fields: [idolId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}