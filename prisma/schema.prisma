generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
url = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
}

model DeityIdol {
  id          String      @id @default(cuid())
  name        String
  templeName  String?
  location    String?
  description String?
  accessCode  String?     // Specific password/code for this idol
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  images      IdolImage[]
}

model IdolImage {
  id        String    @id @default(cuid())
  url       String
  caption   String?
  occasion  String?
  isPrimary Boolean   @default(false)
  idolId    String
  idol      DeityIdol @relation(fields: [idolId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}
model BlogPost {
  id        String   @id @default(cuid())
  title     String
  type      String   // "TEXT", "IMAGE", or "VIDEO"
  content   String?  // Rich text or description
  mediaUrl  String?  // Base64 Image URL or YouTube link/ID
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}